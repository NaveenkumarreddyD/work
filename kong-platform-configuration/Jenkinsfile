// GitLab -> Jenkins -> decK -> Kong Konnect.
// Install required plugins/agents and configure credentials per docs/OPERATIONS.md.
// Fail-closed: example environment targets and API approval are disabled.
properties([
  parameters([
    choice(name:'ACTION', choices:['AUTO','DEPLOY','ROLLBACK','DRIFT','BACKUP'], description:'AUTO on protected main deploys only changed APIs to DEV'),
    choice(name:'TARGET_ENV', choices:['dev','uat','training','preprod','prod'], description:'Manual environment'),
    string(name:'API_NAME', defaultValue:'example-orders', description:'One API folder, kebab-case'),
    string(name:'RELEASE_TAG', defaultValue:'', description:'Required for higher-environment DEPLOY/DRIFT/BACKUP'),
    string(name:'ROLLBACK_TAG', defaultValue:'', description:'Previously successful protected release tag'),
    string(name:'CHANGE_TICKET', defaultValue:'', description:'Required for higher envs and rollback'),
    booleanParam(name:'ALLOW_DELETIONS', defaultValue:false, description:'Requires separate elevated approval'),
    booleanParam(name:'TAKE_PRECHANGE_SNAPSHOT', defaultValue:false, description:'Only for high-risk change; secure backup dir required'),
  ]),
  disableConcurrentBuilds(),
  buildDiscarder(logRotator(numToKeepStr:'100'))
])

def isProtectedMain = { -> env.BRANCH_NAME == 'main' && !env.CHANGE_ID }
def selectedApi = params.API_NAME.trim()
if (!(selectedApi ==~ /[a-z][a-z0-9-]{2,62}/)) error('Invalid API_NAME')
def targetEnv = params.ACTION == 'AUTO' ? 'dev' : params.TARGET_ENV
def action = params.ACTION
if (action == 'AUTO' && !isProtectedMain()) {
    echo 'AUTO is only enabled on protected main after merge; merge requests are validation-only.'
}
if (action == 'ROLLBACK' && !params.ROLLBACK_TAG.trim()) error('ROLLBACK_TAG required')
if (action != 'AUTO' && targetEnv != 'dev' && !params.CHANGE_TICKET.trim()) error('Change ticket required for non-DEV')
if (action == 'DEPLOY' && targetEnv != 'dev' && !params.RELEASE_TAG.trim()) error('Protected release tag required for higher-environment deployment')
if (action == 'DEPLOY' && targetEnv == 'dev' && !isProtectedMain() && !params.RELEASE_TAG.trim()) error('Manual DEV without protected main requires a release tag')
if (params.ALLOW_DELETIONS && action != 'DEPLOY' && action != 'ROLLBACK') error('ALLOW_DELETIONS valid only for deploy/rollback')

node('kong-validate') {
  stage('Checkout + tests') {
    checkout scm
    sh 'python3 -m unittest discover -s tests -v'
    sh 'python3 scripts/kong_config.py --api example-orders --env dev --out build/local-check.yaml'
    sh 'deck file validate --konnect-compatibility build/local-check.yaml'
    sh 'python3 scripts/validate_all.py'
    sh 'python3 -m compileall -q scripts'
  }
}

def apiList=[]
if (action == 'AUTO') {
  if (isProtectedMain()) {
    node('kong-validate') {
      checkout scm
      apiList = sh(script:'python3 scripts/changed_apis.py',returnStdout:true).trim().split('\n').findAll{it}
    }
  }
} else {
  apiList = [selectedApi]
}
if (apiList.isEmpty()) {
  echo 'No eligible API changes. Nothing deployed.'
  return
}

for (String api : apiList) {
  String targetLabel = targetEnv == 'prod' || targetEnv == 'preprod' ? 'kong-prod' : 'kong-nonprod'
  node(targetLabel) {
    // Jenkins Git checkout must have access to GitLab remote tags on this agent.
    stage("Checkout ${api} ${targetEnv}") {
      deleteDir()
      checkout scm
      if (action == 'ROLLBACK') {
        withEnv(["RELEASE_TAG=${params.ROLLBACK_TAG.trim()}"]) {
          sh 'bash scripts/verify_release_ref.sh'
        }
      } else if ((action == 'DEPLOY' || action == 'DRIFT' || action == 'BACKUP') && params.RELEASE_TAG.trim()) {
        withEnv(["RELEASE_TAG=${params.RELEASE_TAG.trim()}"]) {
          sh 'bash scripts/verify_release_ref.sh'
        }
      }
      if (action == 'AUTO' && !isProtectedMain()) error('AUTO cannot mutate from a merge request')
      if (action == 'AUTO' && targetEnv != 'dev') error('AUTO cannot deploy above DEV')
      sh "python3 scripts/kong_config.py --api '${api}' --env '${targetEnv}' --strict --out 'build/${targetEnv}-${api}.yaml'"
    }
    def credentialId = "kong-konnect-${targetEnv}"
    def smokeCredentialId = "kong-smoke-${targetEnv}"
    def apiLock = "kong-${targetEnv}-${readFile("apis/${api}/api.yaml").readLines().find{it.startsWith('tier: ')}.replace('tier: ','').trim()}"
    def deployment = action in ['AUTO','DEPLOY','ROLLBACK']
    // Lock by environment and tier, not by API: one Control Plane is updated at a time.
    lock(resource: apiLock) {
      stage("Plan ${api} -> ${targetEnv}") {
        withCredentials([string(credentialsId:credentialId, variable:'DECK_KONNECT_TOKEN')]) {
          withEnv(["TARGET_ENV=${targetEnv}","API_NAME=${api}","DEPLOY_ACTION=plan"]) {
            sh 'bash scripts/deploy.sh'
          }
        }
      }
      if (deployment) {
        stage("Approval ${api} -> ${targetEnv}") {
          // Even DEV is approved via protected merge. Other deployments require human authorization.
          if (targetEnv != 'dev' || action == 'ROLLBACK' || params.ALLOW_DELETIONS || params.TAKE_PRECHANGE_SNAPSHOT) {
            input message:"Approve ${action} ${api} to ${targetEnv}? Review decK diff and ticket ${params.CHANGE_TICKET}", ok:'Approve', submitterParameter:'APPROVER'
          }
          if (params.ALLOW_DELETIONS && !params.TAKE_PRECHANGE_SNAPSHOT) error('Deletions require pre-change snapshot')
        }
        stage("Deploy ${api} -> ${targetEnv}") {
          withCredentials([string(credentialsId:credentialId, variable:'DECK_KONNECT_TOKEN')]) {
            withEnv(["TARGET_ENV=${targetEnv}","API_NAME=${api}","DEPLOY_ACTION=deploy", "ALLOW_DELETIONS=${params.ALLOW_DELETIONS}","BACKUP_ALLOWED=${params.TAKE_PRECHANGE_SNAPSHOT}"]) {
              sh 'bash scripts/deploy.sh'
            }
          }
        }
        stage("Verify ${api} -> ${targetEnv}") {
          withCredentials([string(credentialsId:smokeCredentialId, variable:'SMOKE_BEARER_TOKEN')]) {
            withEnv(["STATE_MANIFEST=build/${targetEnv}-${api}.manifest.json"]) {
              sh 'bash scripts/smoke.sh'
            }
          }
        }
        echo "SUCCESS: API=${api}, ENV=${targetEnv}, REF=${sh(script:'git rev-parse HEAD',returnStdout:true).trim()}, RELEASE_TAG=${params.RELEASE_TAG}, ROLLBACK_TAG=${params.ROLLBACK_TAG}, CHANGE=${params.CHANGE_TICKET}"
      } else if (action == 'BACKUP') {
        stage("Back up ${api} -> ${targetEnv}") {
          withCredentials([string(credentialsId:credentialId, variable:'DECK_KONNECT_TOKEN')]) {
            withEnv(["TARGET_ENV=${targetEnv}","API_NAME=${api}","DEPLOY_ACTION=backup"]) {
              sh 'bash scripts/deploy.sh'
            }
          }
        }
      } else if (action == 'DRIFT') {
        echo 'Read-only diff completed. Review build logs for unexpected drift.'
      }
    }
    stage("Audit ${api} -> ${targetEnv}") {
      archiveArtifacts artifacts:'build/*.manifest.json,build/*diff.txt', allowEmptyArchive:true, fingerprint:true
    }
  }
}
